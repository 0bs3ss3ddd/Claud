{
  "name": "parta-tutor",
  "version": "1.0.0",
  "private": true,
  "description": "ПАРТА — онлайн-репетитор для подготовки к ЕГЭ и олимпиадам (ВсОШ, РСОШ)",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "check:content": "node scripts/check-content.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource/onest": "^5.3.1",
    "@fontsource/unbounded": "^5.3.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "katex": "^0.18.9",
    "leaflet": "^1.9.4"
  }
}
