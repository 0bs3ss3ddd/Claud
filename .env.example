# ── Основное ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Публичный адрес сайта (для ссылок возврата из ЮKassa и проверки Origin)
PUBLIC_URL=https://parta.example.ru
# Сайт за обратным прокси (nginx, Render, Railway…): число прокси-хопов
TRUST_PROXY=1
# Путь к базе SQLite
DB_PATH=./data/parta.db
BRAND_NAME=ПАРТА
# Секрет для подписи ответов наставника (≥ 32 случайных символов):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# ── ИИ-наставник ───────────────────────────────────────────
# Можно подключить любой из провайдеров (или несколько). Без ключей наставник
# работает в демо-режиме: подсказки и разборы задач каталога доступны,
# свободный диалог и Решатель — нет.
#
# Порядок: первый — основной, следующие — резерв, если основной не ответил.
# Пусто — все настроенные в порядке anthropic, yandexgpt, gigachat, deepseek.
TUTOR_PROVIDERS=gigachat,yandexgpt,deepseek

# ── YandexGPT (Yandex Cloud → AI Studio) ───────────────────
# Сервисный аккаунт с ролью ai.languageModels.user → API-ключ; ID каталога.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# yandexgpt/latest (Pro), yandexgpt-lite/latest или полный gpt://… URI
YANDEX_MODEL=yandexgpt/latest
YANDEX_TEMPERATURE=0.3
YANDEX_MAX_TOKENS=4000

# ── GigaChat (developers.sber.ru → GigaChat API) ───────────
# «Ключ авторизации» из личного кабинета (Base64 от Client ID:Client Secret)
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлица
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_MAX_TOKENS=4000
# Путь к корневому сертификату НУЦ Минцифры (russian_trusted_root_ca.cer
# с gosuslugi.ru/crt). Без него запросы к Сберу не пройдут проверку TLS.
GIGACHAT_CA_CERT=./certs/russian_trusted_root_ca.cer

# ── DeepSeek (platform.deepseek.com) ───────────────────────
# Внимание: серверы DeepSeek в Китае — это трансграничная передача данных.
DEEPSEEK_API_KEY=
# deepseek-v4-pro (сильнее) или deepseek-flash (дешевле и быстрее)
DEEPSEEK_MODEL=deepseek-v4-pro
# Режим рассуждений: точнее на задачах, но дольше
DEEPSEEK_THINKING=true
# low | high | max
DEEPSEEK_EFFORT=high
DEEPSEEK_MAX_TOKENS=16000

# ── Claude (Anthropic) ─────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max — глубина рассуждений (и стоимость)
TUTOR_EFFORT=high
TUTOR_MAX_TOKENS=16000
# Серверный фолбэк на другую модель при отказе (только Claude API)
ANTHROPIC_FALLBACKS=true

# ── Тарифы ─────────────────────────────────────────────────
PRO_PRICE_RUB=499
PRO_PERIOD_DAYS=30
# Сообщений наставнику в сутки для «Отличника» (защита от злоупотреблений и бюджета API)
PRO_DAILY_MESSAGES=40
# Сообщений в бесплатном разборе недели
TRIAL_MESSAGES=6
# Бесплатных разборов из одной сети (IP) в неделю
TRIAL_PER_IP_WEEKLY=15
# ИИ-сообщений во всех бесплатных разборах за сутки (общий бюджет)
TRIAL_AI_DAILY_LIMIT=300

# ── Оплата: ЮKassa ─────────────────────────────────────────
# Личный кабинет ЮKassa → Интеграция → Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Отправлять чек (54-ФЗ) — если магазин подключён к онлайн-кассе ЮKassa
YOOKASSA_SEND_RECEIPT=false
# Ставка НДС в чеке: 1 — без НДС
YOOKASSA_VAT_CODE=1
# Демо-оплата без денег (НЕ включайте в production). По умолчанию включена
# только при PUBLIC_URL=http://localhost… вне production.
PAYMENTS_DEMO=false

# ── Картинки для наставника (Википедия) ────────────────────
MEDIA_FETCH=true
MEDIA_USER_AGENT=PartaTutor/1.0 (https://parta.example.ru; admin@parta.example.ru)
